<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      .NET 10's Microsoft.AspNetCore.OpenApi reads XML doc comments, so the <summary> on every
      request and response record becomes the schema description in Swagger. That is the whole
      reason to turn this on.
      CS1591 (missing XML comment on a public member) is suppressed: the documentation that
      matters here is on the contracts, not on every endpoint lambda.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoomboCard.Catalog\BoomboCard.Catalog.csproj" />
    <ProjectReference Include="..\BoomboCard.Catalog.Migrations.SqlServer\BoomboCard.Catalog.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\BoomboCard.Customers\BoomboCard.Customers.csproj" />
    <ProjectReference Include="..\BoomboCard.Customers.Migrations.SqlServer\BoomboCard.Customers.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\BoomboCard.Promotions\BoomboCard.Promotions.csproj" />
    <ProjectReference Include="..\BoomboCard.Promotions.Migrations.SqlServer\BoomboCard.Promotions.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\BoomboCard.Loyalty\BoomboCard.Loyalty.csproj" />
    <ProjectReference Include="..\BoomboCard.Loyalty.Migrations.SqlServer\BoomboCard.Loyalty.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\BoomboCard.Sales\BoomboCard.Sales.csproj" />
    <ProjectReference Include="..\BoomboCard.Sales.Migrations.SqlServer\BoomboCard.Sales.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\BoomboCard.Payments\BoomboCard.Payments.csproj" />
    <ProjectReference Include="..\BoomboCard.Payments.Migrations.SqlServer\BoomboCard.Payments.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\BoomboCard.Notifications\BoomboCard.Notifications.csproj" />
    <ProjectReference Include="..\BoomboCard.Notifications.Migrations.SqlServer\BoomboCard.Notifications.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\BoomboCard.SharedKernel\BoomboCard.SharedKernel.csproj" />
    <ProjectReference Include="..\BoomboCard.SharedKernel.Persistence\BoomboCard.SharedKernel.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!--
      Token validation and issuing live in the host, which is why these are here and not in the
      Customers module: the signing key and the token format are deployment concerns, and the
      process that checks a signature should be the one that produces one. The module therefore
      references no JWT package at all — it implements IAccessTokenIssuer's CALLER, and the host
      implements the interface.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <!--
      Polly, via Microsoft.Extensions.Http.Polly, for the payment gateway's retry, timeout and
      backoff. Onyx A14: `new HttpClientHandler` and `new HttpClient(handler)` on every call
      inside a hand-rolled retry loop, leaving a socket in TIME_WAIT per attempt.
    -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <!--
      The provider lives HERE, not in the module. AddCatalogModule takes an
      Action<DbContextOptionsBuilder>, so switching the database is one line in this file plus
      one in Program.cs and a connection string — which is what moving from SQLite to SQL Server
      actually took.
      Onyx claimed "swapping the provider later is a one-line change in Program.cs" (X13) while
      using raw SQL with SQLite-specific COLLATE NOCASE, EnsureCreated instead of migrations, and
      no configured decimal precision.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!--
      OpenTelemetry lives in the HOST only. The OTLP endpoint, the sampling ratio and the
      instrumentation set are deployment concerns, so they sit next to the EF provider and the
      JWT packages for the same reason. The modules emit spans through ActivitySource from the
      shared framework and reference nothing.
    -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
