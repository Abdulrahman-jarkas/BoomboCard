{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Catalog": "Server=(localdb)\\MSSQLLocalDB;Database=BoomboCard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Customers": "Server=(localdb)\\MSSQLLocalDB;Database=BoomboCard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Promotions": "Server=(localdb)\\MSSQLLocalDB;Database=BoomboCard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Loyalty": "Server=(localdb)\\MSSQLLocalDB;Database=BoomboCard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Sales": "Server=(localdb)\\MSSQLLocalDB;Database=BoomboCard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Payments": "Server=(localdb)\\MSSQLLocalDB;Database=BoomboCard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Notifications": "Server=(localdb)\\MSSQLLocalDB;Database=BoomboCard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "//Observability": [
    "No OtlpEndpoint here, deliberately. A committed default would point every deployment at",
    "localhost:4317 and silently export nothing — the failure mode this codebase keeps",
    "refusing. Supply Observability:OtlpEndpoint from the environment, or leave Enabled unset",
    "and set it to false to run with no instrumentation at all.",
    "",
    "Unlike Jwt:Key, a missing value here does NOT stop the host from starting. An application",
    "with no signing key cannot serve a request; one with no dashboard can serve every request",
    "it was asked to. Telemetry is never allowed to be the reason something does not work."
  ],

  "Catalog": {},

  "Jwt": {
    "Issuer": "boombocard",
    "Audience": "boombocard-api"
  },

  "Customers": {},

  "Promotions": {},

  "Loyalty": {},

  "Sales": {},

  "Payments": {},

  "Notifications": {}
}
