<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Loyalty's migrations for SQL Server, in their own assembly, for the same reason the other
    modules' are: EF's generated model snapshot calls provider-specific APIs and will not
    compile without the provider referenced, and putting the provider into the module would make
    the AddLoyaltyModule(Action<...>) seam a fiction.
  -->
  <ItemGroup>
    <ProjectReference Include="..\BoomboCard.Loyalty\BoomboCard.Loyalty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

</Project>
