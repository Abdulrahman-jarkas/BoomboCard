<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    No database provider package.

    Sales references FIVE other modules' Contracts and none of their modules — it is the one
    place in the system that orchestrates across boundaries, so it is also the best test of
    whether the Contracts seam is real. Asserted by Modules_SeeEachOtherOnlyThroughContracts.

    Payments.Contracts was added in Phase 5, and note the direction: Payments references
    Sales.Contracts (for the order total) and Sales references Payments.Contracts (for the
    capture, decline, failure and refund events). Not a cycle, because neither Contracts project
    references a module — the same arrangement Sales and Loyalty already have.
  -->
  <ItemGroup>
    <ProjectReference Include="..\BoomboCard.Sales.Contracts\BoomboCard.Sales.Contracts.csproj" />
    <ProjectReference Include="..\BoomboCard.Catalog.Contracts\BoomboCard.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\BoomboCard.Customers.Contracts\BoomboCard.Customers.Contracts.csproj" />
    <ProjectReference Include="..\BoomboCard.Promotions.Contracts\BoomboCard.Promotions.Contracts.csproj" />
    <ProjectReference Include="..\BoomboCard.Loyalty.Contracts\BoomboCard.Loyalty.Contracts.csproj" />
    <ProjectReference Include="..\BoomboCard.Payments.Contracts\BoomboCard.Payments.Contracts.csproj" />
    <ProjectReference Include="..\BoomboCard.SharedKernel\BoomboCard.SharedKernel.csproj" />
    <ProjectReference Include="..\BoomboCard.SharedKernel.Persistence\BoomboCard.SharedKernel.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BoomboCard.Sales.Tests" />
    <InternalsVisibleTo Include="BoomboCard.Sales.Migrations.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ErrorOr" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>
