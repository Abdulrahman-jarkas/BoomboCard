<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageVersion Include="ErrorOr" Version="2.0.1" />
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!-- The container itself, not just the abstractions. Test projects only: production code
         composes through IServiceCollection and never builds a provider of its own. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!--
      Transitive pin. Microsoft.Data.SqlClient (via EF Core SqlServer) brings
      System.Security.Cryptography.Pkcs 9.0.11, which carries GHSA-846f-f764-76mx.
      CentralPackageTransitivePinningEnabled lets us pull it forward without waiting for the
      upstream package to update.
      This is the second advisory the audit gate has caught during this build — Onyx shipped
      with NU1903 reported on every single compile and nobody acted on it (S18).
    -->
    <!-- Swagger UI only. The OpenAPI document itself is generated by the built-in
         Microsoft.AspNetCore.OpenApi, so Swashbuckle's generator is not used. -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <!--
      8.19.2, not 8.15.0: EF Core's SqlServer provider pulls Microsoft.Data.SqlClient, which
      pulls Microsoft.IdentityModel.Protocols.OpenIdConnect 8.19.2, which requires at least
      this. Central package management turns that into a build error (NU1109) rather than a
      silent transitive upgrade — which is the behaviour we want, and the opposite of Onyx S18
      where a known-vulnerable transitive package shipped as a warning on every compile.
    -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <!--
      Polly, for the payment gateway's retry/backoff. Onyx A14 hand-rolled a retry loop that
      constructed a new HttpClient and handler per attempt.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.0" />
    <!--
      OpenTelemetry. Only the host references these: the SDK, the exporter and the
      instrumentation are deployment concerns, exactly as the database provider, the JWT signing
      key and the payment gateway are. The modules and the SharedKernel emit spans through
      System.Diagnostics.ActivitySource, which ships in the shared framework and needs no
      package at all — so BoomboCard.SharedKernel stays "deliberately free of EF Core,
      ASP.NET Core and any other infrastructure package" while still being fully instrumented.
      Not referenced, deliberately: OpenTelemetry.Instrumentation.EntityFrameworkCore. It has
      only ever shipped as -beta (1.20.1-beta.1 at the time of writing), and this build treats
      dependency hygiene as a gate rather than a preference — NuGetAuditMode=all, audit level
      low, NU1903/NU1904 as errors, and a transitive pin added the moment an advisory appeared.
      Taking a prerelease dependency to get SQL spans would be the first exception to that, and
      it would buy timing detail the event flow does not depend on. When it goes stable: add the
      package here and AddEntityFrameworkCoreInstrumentation() in ObservabilityComposition.
    -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
  </ItemGroup>

</Project>
